{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:assets": "node scripts/audit-assets.mjs",
    "qa:browser": "playwright test tests/browser --project=chromium --workers=1",
    "qa:a11y": "playwright test tests/browser/accessibility.spec.ts --project=chromium --workers=1",
    "qa:visual": "playwright test tests/visual/visual.spec.ts --project=chromium --workers=1",
    "qa:visual:plan": "node scripts/verify-visual-update-approval.mjs",
    "qa:visual:update": "npm run qa:visual:plan",
    "qa:raw": "node scripts/compare-reference.mjs",
    "qa:all": "npm run lint && npm test && npm run build && npm run qa:assets && npm run qa:browser && npm run qa:a11y && npm run qa:visual && npm run qa:raw"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "22.19.19",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
